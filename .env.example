# Agentware API Keys Configuration

# Together AI
TOGETHER_API_KEY=your_together_api_key_here

# Cerebras
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Fireworks
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Groq
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Web search uses the DuckDuckGo Instant Answer API and needs no key.
# SERPAPI_KEY is reserved for a future SerpAPI backend: it is currently
# not required and is never sent with search requests.
SERPAPI_KEY=

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentware
DB_USER=agentware
DB_PASSWORD=your_db_password_here
